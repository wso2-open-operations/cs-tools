[server]
# Total SIGTERM budget covering the four drains below; Choreo's grace period must be 35s or more.
shutdown_grace = "30s"
# After SIGTERM, /healthz answers 503 for this long before the listener closes.
drain_delay = "5s"
# How long a request waits for its ids, and how long in-flight requests get on shutdown.
request_wait = "10s"
# The allocator's own time to write what is queued, even if requests overran.
allocator_drain = "10s"
# Reserved after allocator_drain for the final raw_alerts insert, so buffered webhook bodies are written before exit.
payload_drain = "5s"
read_timeout = "10s"
write_timeout = "30s"
# Keep-alive connections idle this long are closed.
idle_timeout = "60s"
# Bodies over this are answered 413 and never claim an id.
max_body_bytes = 1048576

[allocator]
# Submissions waiting for a writer; absorbs a ~10s burst at 1,000 alerts/sec before new webhooks get 503.
queue_size = 10000
# Memory cap on accepted, unfinished alerts before 503; about half the container memory limit.
queue_max_bytes = 268435456
# Most alerts written in one batch: one alert_seq claim plus one insert statement.
max_batch = 500
# Batches written concurrently per replica; the pool is sized to this plus 4.
write_concurrency = 16

[store]
# Attempts for a failed batch insert before its senders get 503; retries reuse the same ids and are idempotent.
insert_attempts = 5
# Delay before the second attempt; doubles each time (250ms, 500ms, 1s, 2s).
insert_base_delay = "250ms"
# Per-statement timeout for batch inserts.
query_timeout = "2s"
# Timeout for the alert_seq claim, longer so a slow claim isn't a failure.
claim_timeout = "5s"
# How long a batch may retry; keep it under server.request_wait so a sender never gets a timeout 503 for an alert that was later stored.
write_deadline = "8s"

[postgres]
# Startup connection retry, so a transient blip doesn't crash-loop the pod.
connect_max_attempts = 5
connect_base_delay = "2s"
connect_timeout = "10s"
# Connections kept open per replica, so a webhook after a quiet spell doesn't wait on a new TLS connection.
min_conns = 2
# Time limit for one integration_users refresh query.
auth_timeout = "5s"
# Credentials are checked against an in-memory copy of integration_users reloaded this often; user changes apply within it.
auth_refresh_interval = "30s"
# While refreshes fail, the last good copy keeps serving this long; after that, auth answers 503.
auth_max_stale = "15m"

[wake]
# Timeout for the fire-and-forget POST /alertz to alerts-core.
timeout = "2s"

[reject]
# How much of a rejected body is kept for logging.
body_preview_chars = 500

[log]
# Raw webhook body logged once per request before the transform; longer bodies are truncated, 0 turns it off.
payload_max_bytes = 65536

[payloads]
# Raw webhook bodies wait in memory this long, then are written to raw_alerts in one insert.
flush_interval = "5m"
# Memory cap for waiting bodies; half of it flushes early, and a body past it is not stored.
max_buffer_bytes = 33554432
# Time limit for one flush insert.
flush_timeout = "30s"
