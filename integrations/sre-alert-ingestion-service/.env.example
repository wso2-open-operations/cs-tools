# Buffer database (dedicated to this service — never CSM's own database).
# Configured as discrete host/port/user/password/name/sslmode vars (not a
# single connection-string env var) so the DSN is built in code via
# url.UserPassword, which automatically percent-encodes any reserved
# character (e.g. "?", "@", "/", a space) in DB_USER/DB_PASSWORD — a
# hand-built postgres://user:password@host/db string requires the operator
# to do that encoding themselves, and a stray "?" in the password otherwise
# gets misread as the start of the query string.
# Apply migrations/0001_create_alert_buffer.up.sql against this database
# before first run.
# DB_HOST/DB_PORT default to localhost/5432. DB_USER/DB_PASSWORD/DB_NAME are
# required; the service refuses to start without them.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# No default — empty is a valid value (pgx applies its own default sslmode
# behavior). This service is likely to run against a managed Postgres (e.g.
# Azure Database for PostgreSQL), which typically requires TLS, so a real
# deployment will usually set this explicitly, e.g.:
# DB_SSLMODE=require
DB_SSLMODE=

# csm-integration-service (this service's downstream M2M call target)
CSM_INTEGRATION_BASE_URL=
CSM_INTEGRATION_TOKEN_URL=
CSM_INTEGRATION_CLIENT_ID=
CSM_INTEGRATION_CLIENT_SECRET=
CSM_INTEGRATION_SCOPES=

# Incident authorship. A real, operator-provisioned CSM user id used as
# CallerID on every incident this service creates — CSM has no "system"/
# machine-caller concept today. Required; the service refuses to start
# without it. See README.md's "Known limitations" section.
SRE_ALERT_CALLER_ID=

# Service-UUID resolution. Every incident requires a CMDB service UUID
# (serviceId), but the alert's own Service field is a human-readable label
# (e.g. a vendor's monitoringService, or a fixed adapter literal like
# "Site24x7 Monitoring"), never a UUID itself. See README.md's "Service-UUID
# resolution" section for the full static-map/live-search/cache design.
#
# Optional JSON object mapping a label -> CMDB service UUID, consulted
# synchronously before an alert is ever buffered. Unset/empty is valid and
# means "no static entries" — every alert falls through to the live-search
# fallback below. Malformed JSON fails startup.
# Example (fake UUID, do not use):
# SRE_ALERT_SERVICE_MAP={"Azure Monitoring":"33333333-3333-3333-3333-333333333333","Site24x7 Monitoring":"44444444-4444-4444-4444-444444444444"}
SRE_ALERT_SERVICE_MAP=

# Required. The CMDB "Unclassified"/catch-all service UUID: the fallback
# used when a buffered alert's label has no SRE_ALERT_SERVICE_MAP entry and
# a live /services/search for it returns a confirmed zero-result match. The
# service refuses to start without it — a deployment whose
# SRE_ALERT_SERVICE_MAP already covers every label it sends can just set
# this once and never see it used.
SRE_ALERT_UNKNOWN_SERVICE_ID=

# Inbound authentication for POST /alerts. This service has no gateway in
# front of it on AKS, so it authenticates every request itself via HTTP
# Basic Auth. Required; the service refuses to start without it.
# Comma-separated "username:bcryptHash" pairs, one per alert source.
# Generate a hash without putting the password in shell history:
# read -r -s -p 'Password: ' password; printf '\n'; printf '%s' "$password" | go run ./cmd/server gen-basic-auth-hash; unset password
# Example (fake values, do not use):
# SRE_ALERT_AUTH_USERS=datadog:$2a$10$abcdefghijklmnopqrstuuXk4y5z6A7B8C9D0E1F2G3H4I5J6K7L8,grafana:$2a$10$zyxwvutsrqponmlkjihgfeXk4y5z6A7B8C9D0E1F2G3H4I5J6K7L8
SRE_ALERT_AUTH_USERS=

# Retry / escalation tuning
SRE_ALERT_MAX_RETRIES=3
SRE_ALERT_POLL_INTERVAL_SECONDS=15

# Incident-grouping window: an earlier alert's incident is only groupable
# onto if it was created within this many minutes. See CLAUDE.md's grouping
# section for why 15 is the default.
SRE_ALERT_GROUP_WINDOW_MINUTES=15

# Twilio voice-call escalation, fired once SRE_ALERT_MAX_RETRIES is exhausted
# for a buffered alert.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# v1 scope: a single static on-call number, not a live rotation lookup.
# See README.md's "Known limitations" section.
SRE_ALERT_ONCALL_NUMBER=
# Optional: Twilio <Say> voice/language and API base URL override.
TWILIO_VOICE=
TWILIO_LANGUAGE=
TWILIO_API_BASE_URL=

# Google Chat escalation, fired alongside the Twilio call and the
# escalation email below -- all three fire independently, not a
# first-success-wins race. See notifications.MultiChannelEscalator.
# Incoming-webhook URL for the space escalations should land in.
GOOGLE_CHAT_ESCALATION_WEBHOOK_URL=

# Email escalation, via the same internal email-notification service
# integrations/csm-notification-service already uses.
EMAIL_SERVICE_BASE_URL=
EMAIL_SERVICE_TOKEN_URL=
EMAIL_SERVICE_CLIENT_ID=
EMAIL_SERVICE_CLIENT_SECRET=
EMAIL_SERVICE_SCOPES=
SRE_ALERT_ESCALATION_EMAIL_FROM=
# Comma-separated recipient list, e.g. sre@wso2.com,oncall@wso2.com
SRE_ALERT_ESCALATION_EMAIL_TO=

# Server
PORT=8080
