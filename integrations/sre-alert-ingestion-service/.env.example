# Copy to .env and fill in real values. No quotes: docker --env-file keeps them literally.

# Azure Flexible Server PostgreSQL connection (same variables as sre-alert-core-service).
PGHOST=your-server.postgres.database.azure.com
PGDATABASE=alertintegration
PGUSER=your-db-user
PGPASSWORD=your-db-password
# Optional: defaults to 5432.
PGPORT=5432
# Optional: defaults to "require" (Azure Flexible Server's minimum).
PGSSLMODE=require
# Optional: empty sizes the pool from allocator.write_concurrency.
PGPOOLMAXCONNS=

# alerts-core's POST /alertz, called per written batch; empty skips it and the 10s poll still runs.
ALERT_CORE_WAKE_URL=

# true checks source webhooks against integration_users (curl -u user:secret); false accepts all.
AUTH_ENABLED=false
# true logs what would be rejected but rejects nothing; use with AUTH_ENABLED during rollout.
AUTH_AUDIT_ONLY=false

# Shared secret for the wake call, the same value as alerts-core's ALERT_CORE_WAKE_TOKEN (generate with
# `openssl rand -hex 32`); sent as "Authorization: Bearer <token>", only over https.
ALERT_CORE_WAKE_TOKEN=

# Google Chat webhook for one dedicated space: each database outage gets a DATABASE CONNECTION FAILURE
# card, and every alert that fails its last write is posted as a reply in its thread (alerts, not
# incidents). Must be https; a secret, since the URL carries the key and token. Empty only logs them.
DB_FALLBACK_CHAT_WEBHOOK_URL=

# Optional per-source overrides: the value of ServiceNow's edge.api.<source>.alert.config property,
# as one line of JSON. Empty uses the built-in defaults. Keys are case-sensitive.
AWS_ALERT_CONFIG=
AZURE_ALERT_CONFIG=
DATADOG_ALERT_CONFIG=
ELASTICSEARCH_ALERT_CONFIG=
GCP_ALERT_CONFIG=
ICINGA_ALERT_CONFIG=
OPENOBSERVE_ALERT_CONFIG=
OPENSEARCH_ALERT_CONFIG=
PROMETHEUS_ALERT_CONFIG=
# Site24x7 maps monitor tags to fields through TagList; Defaults fill in any field no mapped tag supplies.
SITE24X7_ALERT_CONFIG={"TagList":{"Service":"Service","Environment":"Environment","Category":"Category"},"Defaults":{"Service":"","Category":"Service Interruption","Environment":"Production","Severity":"Critical"}}

# Optional: path to config.toml; defaults to ./config.toml, and a missing file means built-in defaults.
CONFIG_PATH=

# HTTP port. Optional: defaults to 8080.
PORT=8080
