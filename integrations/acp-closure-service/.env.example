# csm-integration-service (M2M gateway — see internal/entity for why this,
# not entity-service directly)
CSM_INTEGRATION_BASE_URL=
CSM_INTEGRATION_TOKEN_URL=
CSM_INTEGRATION_CLIENT_ID=
CSM_INTEGRATION_CLIENT_SECRET=

# Required, space-separated. OAuth2 scopes requested from the token endpoint.
# Kept out of code (rather than hardcoded) so the requested grant can be
# adjusted without a redeploy — Asgardeo (the IdP) is the real enforcement
# point regardless, so this only controls what's requested, never what the
# client can actually obtain. See entity.RequiredScopes for the scope set
# csm-integration-service currently requires.
CSM_INTEGRATION_SCOPES=

# sales-entity-service (Salesforce). Required: each project's dates, account
# people and classification, primary partner, contacts, linked opportunities,
# opportunities and invoices are read live from here, and a suspended
# project's State__c is set to Suspended here; CSM keeps the open-project
# list, closure states and notices sent. The client needs access to
# PATCH /projects/{id} as well as the searches. The run stops at
# startup if any of the first four is missing. SALES_ENTITY_SCOPES is
# optional (sales-entity-service relies on the gateway).
SALES_ENTITY_BASE_URL=
SALES_ENTITY_TOKEN_URL=
SALES_ENTITY_CLIENT_ID=
SALES_ENTITY_CLIENT_SECRET=
SALES_ENTITY_SCOPES=

# Safety toggle. Defaults to true (dry-run) on anything except an explicit,
# successfully-parsed "false" — unset, empty, or malformed all fail safe.
# Set to false only for a real cutover run.
DRY_RUN=true

# Optional. When set, the sweep is scoped to exactly this one project ID —
# fetched directly via GET /projects/{id} — instead of searching every
# "Open" project in the environment. Leave unset for a real production run.
# Safe to combine with DRY_RUN=false for an end-to-end test against a single
# dedicated project without touching anything else.
TEST_PROJECT_ID=

# Optional, comma-separated project IDs. Any project ID listed here is
# skipped entirely by the sweep — never fetched, never evaluated. For
# deliberate, verified business exclusions only, NOT a workaround for data
# bugs (see CLAUDE.md's "EXCLUDED_PROJECT_IDS" section for the full
# reasoning). Expected to be empty almost all the time in production; fine
# to hold real entries in dev/staging.
EXCLUDED_PROJECT_IDS=

# Safety toggle, same convention as DRY_RUN: defaults to false (log-only,
# via notify.LoggingNotifier) on anything except an explicit "true". When
# true, notify.EmailNotifier is used instead, which genuinely calls the
# real email notification service — see CLAUDE.md's "Real email sending"
# section before ever setting this true anywhere but a deliberate
# production rollout.
IS_EMAIL_SEND_ENABLED=false

# Required only when IS_EMAIL_SEND_ENABLED=true. Credentials for WSO2's internal
# email notification service (owned by the email service team), obtained via a
# Choreo Developer Portal application subscribed to "Email Service - Send
# Email". Unlike CSM_INTEGRATION_SCOPES, no scope is required for this
# token endpoint (confirmed with the email service team).
EMAIL_SERVICE_BASE_URL=
EMAIL_SERVICE_TOKEN_URL=
EMAIL_SERVICE_CLIENT_ID=
EMAIL_SERVICE_CLIENT_SECRET=

# Required only when IS_EMAIL_SEND_ENABLED=true. The fixed "From" address
# for every outgoing email — no-reply@wso2.com; ask the email service team before
# changing this.
EMAIL_SERVICE_FROM_ADDRESS=

# Safety toggle, defaults to false. When false, EmailNotifier filters out
# any recipient whose address doesn't end in "@wso2.com" before sending —
# a hard requirement from the email service team so staging/testing never emails a
# real customer contact. Only set true in a genuine production environment,
# as a deliberate decision — never just to "make a test send for real".
EMAIL_SERVICE_ALLOW_NON_WSO2_RECIPIENTS=false

# Optional, comma-separated email addresses added to every notice this
# component sends: in "to" on internal notices and the no-business-contact
# nudge, and in both "to" and "cc" on customer-facing notices, as the
# ServiceNow system does (the name is from when these were cc-only). Every
# real legacy email carries customer-lifecycle-notification@wso2.com and
# billing@wso2.com — leave
# this EMPTY in staging/dev, since these are real production distribution
# lists that must not receive test traffic (same reasoning as
# EMAIL_SERVICE_ALLOW_NON_WSO2_RECIPIENTS). Still passes through the
# WSO2-only filter above like any other recipient.
STANDING_CC_RECIPIENTS=
