# OAuth client + refresh token for the mailbox user that receives the group's
# mail. Get the refresh token once with: go run ./cmd/gmail-auth
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional
# Port of the /health endpoint (Choreo liveness probe).
PORT=8080
GMAIL_PROCESSED_LABEL=csm-mail-paging-processed
MAIL_POLL_INTERVAL=30s
MAIL_LOOKBACK=2d

# One entry per watched address. recipient is the group address.
MAIL_TRIGGER_RULES=[{"name":"example","recipient":"group@example.com","senderRegex":"","eventType":"mail.alert.received"}]

EVENT_BUS_BROKER=
EVENT_BUS_CONNECTION_STRING=
EVENT_BUS_TOPIC=
