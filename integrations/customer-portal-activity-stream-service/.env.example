# Shared OAuth2 client credentials — every upstream service client
# authenticates as the same OAuth2 client-credentials app; only the
# base URL and scopes differ per service. Populated from Choreo
# configuration in prod; for local dev fill in from your dev tenant.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# Customer entity service (this repo's entity-service).
CUSTOMER_ENTITY_BASE_URL=
# Optional: comma-separated scopes if the entity service requires them.
# CUSTOMER_ENTITY_SCOPES=

# Azure Event Hub (Kafka-compatible) — the "case-events" topic.
# The producer side lives in entity-service's EventPublisherService, shared
# by csm-portal-backend and customer-portal's backend-v2 alike; this service
# only consumes, in its own consumer group (see EVENT_HUB_CONSUMER_GROUP).
EVENT_HUB_BROKER=
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_TOPIC=case-events
# Base consumer group name; the actual group will be suffixed with
# -replica-<hostname> so every replica gets its own full copy of events
# (LatestOffset) rather than Kafka load-balancing them.
EVENT_HUB_CONSUMER_GROUP=customer-portal-activity-stream-service

# JWT validation for the SSE endpoint.
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Set to "false" to decode without signature verification (local dev only).
# AUTH_TOKEN_VALIDATOR_ENABLED=false

# SSE listener port (default 9092).
STREAM_PORT=9092
# Maximum lifetime of one SSE connection (Go duration, default 4m). The server
# ends the stream cleanly after this time (+-10% jitter per connection) and the
# client reconnects. Must be BELOW the gateway endpoint timeout in front of
# this service (e.g. 50s if a 60 s timeout is in force). 0 disables the bound.
# STREAM_MAX_LIFETIME=4m
# Comma-separated allow-list of browser Origins permitted to connect
# cross-origin to the SSE endpoint. Fail-closed — unset denies every
# cross-origin request (unlike customer-portal's own backend-v2 CORS
# middleware, which defaults open when its allow-list is empty; see
# internal/middleware/cors.go's doc comment for why this service is
# deliberately stricter). The Choreo gateway supplies CORS on its own in
# prod, but this listener's separately-declared endpoint isn't guaranteed
# to inherit that. For local dev (webapp/microapp on :3001):
# STREAM_CORS_ALLOWED_ORIGINS=http://localhost:3001
