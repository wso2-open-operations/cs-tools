# Server
PORT=8080

# Model calls. The key is a secret: never commit it. Leave it empty to start
# without model calls (the generate routes answer 503).
ANTHROPIC_API_KEY=
# Required with the key: the URL of the CSM AI gateway the key belongs to.
# It is an internal address: keep it out of committed files.
CLAUDE_BASE_URL=
# Optional (defaults shown):
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_TIMEOUT=45s

# Catalogue override (default: the copy built into the binary): a directory of
# the catalogue's parts, *.md files joined in name order (catalogue-01.md,
# catalogue-02.md, ...). Read once at start, so restart the service to apply a
# change.
# CATALOGUE_DIR=
