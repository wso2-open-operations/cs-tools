BINARY := server

setup:
	git config core.hooksPath .githooks

vet:
	go vet ./...

test: vet
	go test -race ./...

build: test
	go build -o $(BINARY) ./cmd/server

# Refreshes the committed disposable-domain list from the curated
# disposable-email-domains blocklist (CC0). Review the diff before committing:
# a listed domain's signups are abandoned.
DISPOSABLE_LIST_URL := https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/main/disposable_email_blocklist.conf
DISPOSABLE_LIST := internal/emaildomains/disposable_domains.txt

disposable-list:
	curl -fsSL "$(DISPOSABLE_LIST_URL)" -o $(DISPOSABLE_LIST).tmp
	test $$(wc -l < $(DISPOSABLE_LIST).tmp) -ge 1000
	{ echo "# Source: $(DISPOSABLE_LIST_URL) (CC0 1.0)"; echo "# Generated by make disposable-list; do not edit by hand."; cat $(DISPOSABLE_LIST).tmp; } > $(DISPOSABLE_LIST)
	rm -f $(DISPOSABLE_LIST).tmp

clean:
	rm -f $(BINARY)

.PHONY: setup vet test build disposable-list clean
