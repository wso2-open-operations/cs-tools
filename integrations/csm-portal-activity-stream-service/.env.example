# Shared OAuth2 client credentials — every upstream service client
# authenticates as the same OAuth2 client-credentials app; only the
# base URL and scopes differ per service. Populated from Choreo
# configuration in prod; for local dev fill in from your dev tenant.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# Customer entity service (this repo's entity-service).
CUSTOMER_ENTITY_BASE_URL=
# Optional: comma-separated scopes if the entity service requires them.
# CUSTOMER_ENTITY_SCOPES=

# Azure Event Hub (Kafka-compatible) — the "case-events" topic.
# entity-service is the sole producer; this service only consumes. Each
# replica's consumer group starts at the latest offset (no history replay).
EVENT_HUB_BROKER=
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_TOPIC=case-events
# Base consumer group name; the actual group will be suffixed with
# -replica-<hostname> so every replica gets its own full copy of events
# (LatestOffset) rather than Kafka load-balancing them.
EVENT_HUB_CONSUMER_GROUP=csm-portal-activity-stream-service

# JWT validation for the SSE endpoint.
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Set to "false" to decode without signature verification (local dev only).
# AUTH_TOKEN_VALIDATOR_ENABLED=false

# SSE listener port (default 9092).
STREAM_PORT=9092
# Stream lifetime bounds. A connection is closed (with a terminal
# `stream_closed` event) at min(token exp, connect + STREAM_MAX_LIFETIME);
# the client reconnects with a fresh token. The connect-time case-access
# check is repeated every STREAM_REAUTH_INTERVAL. Go duration syntax.
# STREAM_MAX_LIFETIME=1h
# STREAM_REAUTH_INTERVAL=10m
# Concurrent-stream caps, per replica. Excess connections are refused with
# 429 (per user) or 503 (per replica) plus Retry-After. 0 disables a cap.
# STREAM_MAX_CONNECTIONS_PER_USER=8
# STREAM_MAX_CONNECTIONS=2000
# Comma-separated allow-list of browser Origins permitted to connect
# cross-origin to the SSE endpoint. Fail-closed like CORS_ALLOWED_ORIGINS
# in csm-portal-backend — unset denies every cross-origin request; the
# Choreo gateway supplies CORS on its own in prod, but this listener's
# separately-declared endpoint isn't guaranteed to inherit that. For local
# dev (webapp/microapp on :3001):
# STREAM_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Health check listener port (default 8080). Choreo's liveness probe
# targets this dedicated listener (see .choreo/component.yaml's
# csm-portal-activity-stream-service-health endpoint), not the SSE stream port —
# a long-lived SSE connection isn't a good fit for a liveness check anyway.
# HEALTH_PORT=8080

# CORS for the health listener (:8080). Comma-separated allow-list of
# browser Origins; fail-closed — unset denies every cross-origin request.
# In Choreo prod the gateway supplies CORS; this matters for local dev.
# CORS_ALLOWED_ORIGINS=http://localhost:3001
