# Entity service
ENTITY_BASE_URL=
ENTITY_TOKEN_URL=
ENTITY_CLIENT_ID=
ENTITY_CLIENT_SECRET=
ENTITY_SCOPES=

# Trusted actor asserted on case comment and tag writes. Required: the server
# will not start without a single bare address, which must also be on the
# entity service's trusted-actor allowlist (otherwise those writes are 403).
UMT_INTEGRATION_ACTOR_EMAIL=integration-actor@example.com

# Server
PORT=8080
# Per-operation scope check on every route except GET /health (default true).
# Set to false only for local development against a client that forwards no token.
REQUIRE_OPERATION_SCOPES=true
