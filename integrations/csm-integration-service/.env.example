# Entity service
ENTITY_BASE_URL=
ENTITY_TOKEN_URL=
ENTITY_CLIENT_ID=
ENTITY_CLIENT_SECRET=
ENTITY_SCOPES=

# Per-third-party-client actor email, used only to attribute a markFixIssued
# PATCH /cases/{id} call to the real caller instead of this service's own
# shared client id. JSON object: {"clientId1":"email1","clientId2":"email2"}
MARK_FIX_ISSUED_ACTOR_EMAILS=

# Server
PORT=8080

# Optional: sre-alert-core-service read API (muted alerts, alert field values): its
# "Alert Core Read API" endpoint (https). Called with the ENTITY_* OAuth2 app, which
# must be subscribed to that API in Choreo.
ALERT_CORE_BASE_URL=
ALERT_CORE_SCOPES=
