# Shared OAuth2 client credentials — used by the email notification channel
# below, the customer entity service client (internal/entity), the
# escalation detector client (internal/escalation), and, if REDIS_ADDR is
# set, the SLA engine's own entity-service client (internal/slaengine). The
# real email-service, entity-service, and ai-escalate-comment-detector
# deployments this points at all authenticate every caller through the same
# shared gateway app, scoped via each client's own *_SCOPES var, not a
# separate per-consumer app — mirroring apps/csm-portal/backend's own
# shared-credentials convention. Required (mustEnv) once REDIS_ADDR is set,
# since the SLA engine cannot call entity-service at all without them.
# Twilio is the one channel below that's a genuinely separate provider with
# its own independent credentials.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# Email notification channel. Optional — a missing/empty config only
# surfaces as an error the first time a caller requests the email channel.
# Authenticates with the shared OAUTH2_* credentials above, not its own —
# only BaseURL/Scopes/FromAddress are specific to this client.
EMAIL_BASE_URL=
EMAIL_SCOPES=
EMAIL_FROM_ADDRESS=
# Reply-To for onboarding emails only. Unset = support@wso2.com; empty = none.
# EMAIL_REPLY_TO=support@wso2.com

# Temporary killswitch for the four case.* types' actual email delivery —
# unset or anything but "false" means real sending. Checked before
# EMAIL_DEBUG_MODE below, so it silences email regardless of debug mode —
# stronger than debug mode's redirect-to-a-test-list, meant for temporarily
# silencing email entirely (e.g. while investigating a delivery issue)
# without also having to stop exercising the rest of the pipeline (link
# resolution, Chat, Twilio). Does not affect Google Chat or Twilio.
EMAIL_SENDING_ENABLED=

# Debug mode for the four case.* types' actual email delivery — set to
# "true" to redirect every case.* email to EMAIL_DEBUG_RECIPIENTS below
# instead of the event's real resolved recipients. Unlike a killswitch, the
# email still actually sends (just to a safe test list) — meant for
# exercising a dev/staging deployment end-to-end without risking a real
# mailbox. Recipient links are still resolved against the real recipients
# either way (see internal/recipientlinks). Unset or anything but "true"
# means real sending to real recipients. Does not affect Google Chat or
# Twilio.
EMAIL_DEBUG_MODE=
# Comma-separated email addresses used instead of the real recipients when
# EMAIL_DEBUG_MODE=true. If EMAIL_DEBUG_MODE=true and this is empty, that
# case.* email is skipped entirely (logged) rather than sent to nobody.
EMAIL_DEBUG_RECIPIENTS=

# Google Chat notification channel. Optional — audience-keyed, the only
# Google Chat routing mechanism this service has (there is no product-based
# alternative). One space per Chat audience: a real team name (audience key
# matches the case's own Team, e.g. a CRE team name) or one of the standing
# audiences — "Incident Monitor" (the fixed audience every case.created/
# case.acknowledged/case.severity_changed alert routes to, and the
# default/fallback for SLA breach alerts whenever no other audience applies,
# or a team has no configured space of its own), "Evaluation" (Evaluation
# Subscription projects, overrides every other audience for SLA breach
# alerts), "Onboarding" (project.onboarding_status still in progress), and
# "Americas" (a fixed overnight/weekend IST coverage window) — the latter
# three only ever resolved for SLA breach alerts, via internal/chataudience.
# One SLA breach can resolve to several audiences at once — each gets its
# own independent post. JSON array of {"audience","webhookUrl"} objects;
# webhookUrl comes from that space's Space settings > Apps & integrations >
# Webhooks. Audience matching is whitespace-insensitive but case-sensitive
# (match the exact audience name) — unlike the old product matching this
# replaced, case-folding two distinct real team names together would be a
# worse failure mode than requiring an exact match. Left unset, Google Chat
# alerts are unavailable but startup and every other endpoint work normally.
# An audience with no configured space here is skipped (logged), not an
# error.
# An SRE team's display name (e.g. "MS/PC SRE Group" -- the sr.* payload's
# sreTeamName, exact) is also an audience: it receives that team's service
# request alerts (sr.created / sr.acknowledged / customer comments on a
# devops-sm SR), all in one thread per SR. A team with no entry here gets no
# SR alerts; there is no fallback space. SR events arrive on sre-events, so
# SRE_EVENT_HUB_TOPIC (below) must be set too.
# Example: [{"audience":"Incident Monitor","webhookUrl":"<google-chat-incoming-webhook-url>"},{"audience":"Evaluation","webhookUrl":"<google-chat-incoming-webhook-url>"},{"audience":"MS/PC SRE Group","webhookUrl":"<google-chat-incoming-webhook-url>"}]
GOOGLE_CHAT_SPACES=

# Frustration detection on case.comment_added (internal/escalation,
# dispatch.checkFrustration). Optional — unset means a customer-authored
# comment is never sent for analysis and no frustration Chat alert is ever
# sent; nothing else in this service is affected. Base URL of the existing
# ai-escalate-comment-detector service (a separate deployable, not part of
# this repo) — POST {ESCALATION_DETECTOR_BASE_URL}/escalations. Authenticates
# with the shared OAUTH2_* credentials above, not its own — only BaseURL/
# Scopes are specific to this client. A result crossing that service's own
# configured frustration threshold sends a Chat alert via GOOGLE_CHAT_SPACES
# above, routed the same way an SLA breach alert is (team-first, falling
# back to "Incident Monitor").
# Example: https://ai-escalate-comment-detector-<env>.choreoapis.dev
ESCALATION_DETECTOR_BASE_URL=
ESCALATION_DETECTOR_SCOPES=

# SMS and call notification channels (Twilio). Optional — a missing/empty
# config only surfaces as an error the first time a caller requests the sms
# or call channel (moot today: PostNotification validates both but doesn't
# call SendSMS/MakeCall yet — see its TODO). TWILIO_FROM_NUMBER is always
# required for the call channel (Voice has no MessagingServiceSid
# equivalent). For sms, set TWILIO_MESSAGING_SERVICE_SID (preferred — it's
# what our account actually sends through) or rely on TWILIO_FROM_NUMBER;
# MessagingServiceSid wins if both are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Call channel only: TTS voice/language for <Say> (both optional, empty uses
# Twilio's account default). Full voice list:
# https://www.twilio.com/docs/voice/twiml/say/text-speech#available-voices-and-languages
# Example: TWILIO_VOICE=Polly.Raveena, TWILIO_LANGUAGE=en-IN
TWILIO_VOICE=
TWILIO_LANGUAGE=
# Overrides Twilio's REST API base (default https://api.twilio.com/2010-04-01).
# Optional — only needed for a regional Twilio edge/API endpoint.
TWILIO_API_BASE_URL=

# Temporary killswitch for incident.created's Twilio call specifically —
# unset or anything but "false" means real calling. Unlike EMAIL_DEBUG_MODE
# above, calls have no debug-recipient equivalent, so this keeps the simpler
# disable-entirely (log instead of calling) shape. Does not affect the
# Google Chat alert.
CALL_SENDING_ENABLED=

# Fallback on-call phone number (E.164) for incident.created's call when the
# payload omits callTo — e.g. entity-service, which has no on-call/paging
# system of its own. A publisher that does supply its own callTo still takes
# precedence. incident.created has no Google Chat reaction (voice call only).
INCIDENT_DEFAULT_CALL_TO=

# Comma-separated default CC for every case.* email's CSM-portal-link group
# only (case.created/comment_added/status_changed/assigned/severity_changed)
# — never the customer-portal group, and never while EMAIL_DEBUG_MODE is
# true (a debug run redirects the real `to` list to EMAIL_DEBUG_RECIPIENTS
# specifically so nothing reaches a real mailbox; CC'ing this real, shared
# inbox regardless would defeat that). Empty/unset means no default CC at
# all.
DEFAULT_CSM_EMAIL_CC=

# Customer entity service — backs internal/recipientlinks' per-recipient
# role lookup (POST /users/search only; this client implements nothing
# else). Authenticates with the shared OAUTH2_* credentials above, not its
# own — only BaseURL/Scopes are specific to it. Optional per deployment like
# the channels above (os.Getenv, not mustEnv) — but unlike them, a
# missing/invalid config doesn't just make one channel unavailable: every
# case.* event's email send goes through recipient-link resolution first,
# so an unset CUSTOMER_ENTITY_BASE_URL makes every case.* email fail (a
# startup warning is logged when this happens, since it's louder than a
# normal missing-channel warning).
CUSTOMER_ENTITY_BASE_URL=
CUSTOMER_ENTITY_SCOPES=

# Customer onboarding — project_contact.invited (published by entity-service
# once a Salesforce project-contact membership in state INVITED / RE-INVITED
# is in its database). Two sequential steps, IDENTITY then EMAIL, each
# behind its own opt-in flag and each recorded on entity-service's
# onboarding-step ledger (PUT /onboarding-steps/{membershipSfId}/{step}) as
# SUCCEEDED / FAILED / SKIPPED. Both default off: unset, a deployment records
# both steps SKIPPED and sends nothing. entity-service requires this
# service's OAUTH2_CLIENT_ID to be in its AUTH_INTERNAL_CLIENT_IDS for the
# ledger endpoints (a 403 there means exactly that).
# Set to "true" to create the invitee's Asgardeo user through the SCIM
# operations service (POST /organizations/external/users).
CSM_MIGRATION_ONBOARD_IDENTITY_ENABLED=
# Set to "true" to send the invitation email to the invitee. Still subject
# to EMAIL_SENDING_ENABLED and EMAIL_DEBUG_MODE above like every other
# email.
CSM_MIGRATION_ONBOARD_EMAIL_ENABLED=
# A resend (an admin pressing "Resend invitation" in the portal, which
# entity-service republishes as the same project_contact.invited event with
# isResend set on the payload) deliberately bypasses the duplicate-invitation
# check against entity-service's onboarding-step ledger and uses a third,
# short reminder template. The guard is there to stop an accidental second
# invitation, not a requested one; the EMAIL step is still recorded, so the
# ledger's attempt count keeps counting. No configuration of its own.
# SCIM operations service. Authenticates with the shared OAUTH2_*
# credentials above (same gateway app as the email/entity clients), so only
# BaseURL/Scopes are its own. Required in practice once
# CSM_MIGRATION_ONBOARD_IDENTITY_ENABLED=true (a startup warning is logged if missing).
SCIM_BASE_URL=
SCIM_SCOPES=
# Sender address for the invitation email. Optional — defaults to
# EMAIL_FROM_ADDRESS.
ONBOARD_EMAIL_FROM=
# Sign-in link the invitation points at. Optional — defaults to
# https://support.wso2.com.
ONBOARD_PORTAL_URL=

# CSM portal webapp base URL — used by internal/recipientlinks.Resolver to
# build case links for email notification recipients classified CSM (see
# CUSTOMER_ROLES/CSM_ROLES below for exactly how that classification works —
# it's not just "role in CUSTOMER_ROLES", there's a fallback chain):
# <CSM_PORTAL_WEB_BASE_URL>/cases/{caseId}.
# (e.g. http://localhost:3001 for local dev)
CSM_PORTAL_WEB_BASE_URL=

# Customer portal webapp base URL — the other half of the pair above, used
# for recipients classified customer:
# <CUSTOMER_PORTAL_WEB_BASE_URL>/projects/{projectId}/support/cases/{caseId}.
CUSTOMER_PORTAL_WEB_BASE_URL=

# Role classification for internal/recipientlinks.Resolver: comma-separated
# role names (matching entity-service's own role vocabulary) that get the
# customer portal link vs the CSM portal link. Neither list needs to be
# exhaustive — a recipient whose roles match neither (including when
# entity-service has no record for them at all) falls back to their email
# domain instead: @wso2.com gets the CSM link, anything else gets the
# customer link (see Resolver.linkFor's doc comment).
CUSTOMER_ROLES=
CSM_ROLES=

# Event bus (Azure Event Hub's Kafka-compatible endpoint). This service is a
# pure consumer — csm-portal-backend and customer-portal-backend publish
# directly to EVENT_HUB_TOPIC themselves, there is no HTTP ingest endpoint
# here. Required — unlike the channels above, this is this service's core
# purpose, so a missing value fails startup loudly instead of silently doing
# nothing.
# EVENT_HUB_BROKER is the Kafka bootstrap address:
# "<namespace>.servicebus.windows.net:9093".
# EVENT_HUB_CONNECTION_STRING is the namespace's Shared Access Policy
# connection string (Namespace > Shared access policies > a policy's Primary
# Connection String) — used as the SASL/PLAIN password; never commit a real
# value.
# EVENT_HUB_TOPIC is the Event Hub (Kafka topic) name, e.g. "case-events".
EVENT_HUB_BROKER=
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_TOPIC=
# Consumer group ID the main consumer's instances join to split partitions
# between themselves. Optional — defaults to "csm-notification-service".
EVENT_HUB_CONSUMER_GROUP=
# How many concurrent consumer instances to run for EVENT_HUB_TOPIC. Optional
# — defaults to 1. Each instance joins EVENT_HUB_CONSUMER_GROUP and Kafka
# splits the topic's partitions across however many are running; keep this
# at or below the topic's actual partition count — extra instances just sit
# idle (a startup warning is logged if it doesn't).
MAIN_CONSUMER_COUNT=

# Dead-letter queue — a second Event Hub in the same namespace. Required: a
# record that exhausts the main consumer's retries (see handleAttempts in
# internal/eventbus/consumer.go) is published here instead of being dropped.
# This service's own DLQ consumer (below) then retries it with its own
# retry budget; there is deliberately no third tier past that — a record
# that fails there too is logged and dropped for good.
EVENT_HUB_DLQ_TOPIC=
# Consumer group ID the DLQ consumer's instances join. Optional — defaults
# to "csm-notification-service-dlq".
EVENT_HUB_DLQ_CONSUMER_GROUP=
# How many concurrent consumer instances to run for EVENT_HUB_DLQ_TOPIC.
# Optional — defaults to 1. Same partition-count guidance as
# MAIN_CONSUMER_COUNT above, against the DLQ topic's own partition count.
DLQ_CONSUMER_COUNT=

# Outage emails (outage.notification_due, outage.communication_due) ride their
# own topic and DLQ, published by entity-service's outage notice drainer.
# All optional; defaults shown. OUTAGE_EVENT_HUB_TOPIC must match
# entity-service's.
# OUTAGE_EVENT_HUB_TOPIC=outage-events
# OUTAGE_EVENT_HUB_DLQ_TOPIC=outage-events-dlq
# OUTAGE_CONSUMER_GROUP=csm-notification-service-outage
# OUTAGE_DLQ_CONSUMER_GROUP=csm-notification-service-outage-dlq
# OUTAGE_CONSUMER_COUNT=1
# OUTAGE_DLQ_CONSUMER_COUNT=1
# Outage email links use CSM_PORTAL_WEB_BASE_URL (/operations/outages/{id}).

# One shared operations topic (sre-events) for the change-request notices,
# the outage emails and the service-request (sr.*) Chat alerts, routed by
# event type. Off unless SRE_EVENT_HUB_TOPIC is
# set. When it is:
# - a CR or outage consumer whose topic IS the SRE topic is not started (the
#   SRE consumer reads it instead), so nothing is sent twice;
# - if the CR or outage consumer already reads that topic, the SRE consumer
#   keeps ITS group and continues from its offset (a new group starts at the
#   first offset and would re-send every email still in the topic);
# - an event type this service does not handle is skipped, not dead-lettered.
# SRE_EVENT_HUB_DLQ_TOPIC defaults to "<SRE topic>-dlq" and must exist.
# SRE_EVENT_HUB_TOPIC=sre-events
# SRE_EVENT_HUB_DLQ_TOPIC=sre-events-dlq
# SRE_CONSUMER_GROUP=            (default: taken over / csm-notification-service-sre)
# SRE_DLQ_CONSUMER_GROUP=        (default: taken over / csm-notification-service-sre-dlq)
# SRE_CONSUMER_COUNT=1
# SRE_DLQ_CONSUMER_COUNT=1

# Status page webhooks: outage.status_page_due, published on the SRE topic by
# entity-service the moment an outage is declared or ended, posted here to the
# public status dashboard and reported back to entity-service
# (POST /internal/cloud-status/{id}/delivery, via CUSTOMER_ENTITY_BASE_URL).
# EXACTLY csm-scheduled-tasks' values: base URL per cloud slug (the post goes
# to <url>/api/v1/webhook, https only) and the WHOLE X-Webhook-Signature
# header, "Secret <token>". A value that does not parse stops startup.
# Unset: each event is reported undelivered and csm-scheduled-tasks posts it on
# its next tick. One attempt here; csm-scheduled-tasks retries failures.
# CLOUD_STATUS_WEBHOOK_URLS={"asgardeo":"https://...","choreo":"https://..."}
# CLOUD_STATUS_WEBHOOK_SECRETS={"default":"Secret <token>"}

# Customer-onboarding events (project_contact.invited) ride their own topic
# pair, separate from EVENT_HUB_TOPIC: a separate consumer group isolates
# processing, only a separate topic isolates volume — an invitation backlog
# must never sit behind a flood of case events, and this dead-letter queue is
# watched on its own. All optional; the defaults below are what
# entity-service publishes to. Provision both Event Hubs in Azure before
# deploying — this service doesn't create topics itself.
# Defaults to "project-events".
PROJECT_EVENT_HUB_TOPIC=
# Defaults to "project-events-dlq".
PROJECT_EVENT_HUB_DLQ_TOPIC=
# Consumer group IDs for the two. Optional — default to
# "csm-notification-service-project" and
# "csm-notification-service-project-dlq".
PROJECT_CONSUMER_GROUP=
PROJECT_DLQ_CONSUMER_GROUP=
# How many concurrent consumer instances to run for each. Optional — both
# default to 1; same partition-count guidance as MAIN_CONSUMER_COUNT.
PROJECT_CONSUMER_COUNT=
PROJECT_DLQ_CONSUMER_COUNT=

# SLA breach-alerting engine (internal/slaengine) — optional, gated on
# REDIS_URL or REDIS_ADDR: unset (both) means this engine never starts.
# Not a Kafka consumer of its own: RegisterClocks/ApplyStateEffects/
# CompleteResponseClock are called directly from three of Dispatcher's own
# handlers (case.created/case.status_changed/case.comment_added) on the
# existing main consumer. Only the tick itself runs on its own
# timer (SLA_TICK_INTERVAL below), scanning a Redis wake-index this
# service computes and schedules entirely on its own — not a poll of
# entity-service's GET /sla-status (that table/mechanism is unrelated to
# this engine now; see internal/slaengine's own CLAUDE.md section for the
# full history of why it moved off that design).
#
# REDIS_URL is a rediss://:<password>@<host>:<port> connection string,
# parsed with redis.ParseURL — this is what a managed, TLS-only Redis
# needs (Azure Managed Redis, Azure Cache for Redis): the "rediss" scheme
# makes go-redis dial with TLS automatically. Percent-encode the password
# if it contains +, /, or = (a raw Azure access key does, being base64) —
# e.g. with Python (reads the key from stdin, not argv, so it never lands
# in shell history or a process listing):
# python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.stdin.readline().rstrip(chr(10)), safe=''))"
# (paste the raw key, press enter, then Ctrl-D). Takes priority over
# REDIS_ADDR/REDIS_PASSWORD below when set.
#
# The client here (redis.NewClient) only supports a non-clustered Redis —
# a single logical endpoint, whether that's a real standalone instance or
# a managed Redis under a non-clustered/"Enterprise" clustering policy
# (Azure's own proxy hides the sharding in that mode). It does NOT support
# "OSS Cluster" policy, which needs a cluster-aware client to follow
# MOVED/ASK redirects. Confirm the target resource's clustering policy is
# Enterprise/non-clustered before pointing REDIS_URL at it.
# REDIS_URL=rediss://:<url-encoded-access-key>@<host>:<port>
#
# REDIS_ADDR/REDIS_PASSWORD are the plain, non-TLS pair for a local Redis
# (e.g. localhost:6379) — used only when REDIS_URL is unset. Redis here
# holds every clock's full state — due dates (the wake-index), display
# fields, paused flag, and alerted-tier cursor (see internal/slaengine's
# own CLAUDE.md section) — there is no durable SLA state anywhere else any
# more.
REDIS_ADDR=
REDIS_PASSWORD=
# This engine's own narrow entity-service client talks to the same
# entity-service as CUSTOMER_ENTITY_BASE_URL/CUSTOMER_ENTITY_SCOPES above
# (not a different backend) and reuses those same two variables — required
# once REDIS_URL or REDIS_ADDR is set (mustEnv). Unlike the design this
# replaced, this client is called exactly once, at startup, to fetch
# GET /sla-duration-policy — not on a recurring poll. No separate
# SLA_ENTITY_* variables needed.
# How often this engine scans its own Redis wake-index for a newly-due
# 50/75/100% checkpoint. Optional — defaults to 5m. Accepts any
# time.ParseDuration string (e.g. "1m", "10m"). A shorter interval mostly
# just adds load on Redis for no real benefit — most clocks have hours
# between tiers, so alert latency is rarely the bottleneck.
SLA_TICK_INTERVAL=

# Server
PORT=8080

#
# INCIDENT_EVENT_HUB_TOPIC: where entity-service publishes incident.* events
# when they have their own topic (its INCIDENT_EVENT_HUB_TOPIC), e.g.
# "sre-events". Set here FIRST, then on entity-service. The SRE ladder then
# also reads that topic (customer cases stay on EVENT_HUB_TOPIC); empty or equal
# to EVENT_HUB_TOPIC adds nothing. Its consumer group is
# PAGING_SRE_INCIDENT_CONSUMER_GROUP. The dispatcher
# (incident.created's default on-call call) reads it too: through the
# sre-events consumer when SRE_EVENT_HUB_TOPIC is the same topic, otherwise
# through its own consumer, group INCIDENT_CONSUMER_GROUP (default
# EVENT_HUB_CONSUMER_GROUP + "-incidents"), dead-lettering to the case DLQ.
# INCIDENT_EVENT_HUB_TOPIC=sre-events
# PAGING_SRE_INCIDENT_CONSUMER_GROUP=csm-notification-service-paging-sre-incidents
# INCIDENT_CONSUMER_GROUP=csm-notification-service-incidents
# INCIDENT_CONSUMER_COUNT=1
