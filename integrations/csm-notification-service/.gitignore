# Environment
.env

# Build output -- one entry per cmd/ directory, since `go build ./cmd/<name>`
# writes a binary of that name here. Only /server used to be listed, so a built
# escalation-local was committed by accident once (14 MB, in 4ec698081).
/server
/escalation-local
/ladder-harness
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test output
*.test
*.out
coverage.html
coverage.out

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
