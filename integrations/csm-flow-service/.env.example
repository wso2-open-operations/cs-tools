# CSM Flow Service — environment configuration.
# Every value is a flat single-line string: Choreo's config UI cannot deploy
# nested collections, which is also why flow definitions live in Postgres, not
# here (docs/architecture.md §17.1).

# ── Event bus (REQUIRED) ───────────────────────────────────────────────────
# Azure Event Hub's Kafka-compatible endpoint — this consumer's core purpose,
# so a missing value fails startup loudly. Same namespace/topic the other
# services use; this service joins its own consumer group.
# EVENT_HUB_BROKER: "<namespace>.servicebus.windows.net:9093"
# EVENT_HUB_CONNECTION_STRING: the namespace SAS connection string (the
#   SASL/PLAIN password). Never commit a real value.
# EVENT_HUB_TOPIC: the topic to consume, e.g. "cs-events".
# The CSM Postgres the flows read: the records that trigger them (via the
# event_outbox table csm-sync-service's migration 0045 creates) and the
# audiences they notify (team_member, project_contact). Required.
DATABASE_URL=

# How often to poll event_outbox when the last drain came back empty. A backlog
# drains at full speed regardless -- this only governs the idle case, trading
# notification latency against query volume. Optional, default 5s.
OUTBOX_POLL_INTERVAL=

EVENT_HUB_BROKER=
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_TOPIC=
# Consumer group this service's instances join. Optional — defaults to
# "csm-flow-service". Must be distinct from csm-notification-service's groups
# so both get their own copy of every record (Event Hub fan-out).
EVENT_HUB_CONSUMER_GROUP=

# Dead-letter topic — a second Event Hub in the same namespace. Optional: when
# unset, a record that exhausts its retries is logged and dropped; when set, it
# is republished here instead.
EVENT_HUB_DLQ_TOPIC=

# ── entity-service client (optional at startup) ────────────────────────────
# Needed by any flow that reads or writes entity-service. Authenticates with
# the shared OAUTH2_* app below — only the BaseURL/Scopes are this client's own.
# A missing value only surfaces as an error the first time a flow calls it.
CUSTOMER_ENTITY_BASE_URL=
CUSTOMER_ENTITY_SCOPES=

# Shared OAuth2 client-credentials app (docs/architecture.md §17.3). Do NOT
# invent a per-service client id.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# ── HTTP health server ─────────────────────────────────────────────────────
PORT=8080

# Comma-separated. When set, every notification a flow requests goes to THESE
# addresses instead of its real audience -- approval groups, project contacts,
# watchers -- so a dev or staging deployment can be exercised end to end without
# mail reaching real people. Leave empty in production.
#
# Recipient resolution still runs, so this never masks a broken entity-service
# lookup; only the final list is swapped. A flow that resolves no real
# recipients still sends nothing -- this cannot turn a would-be-silent event
# into mail.
EMAIL_DEBUG_RECIPIENTS=
