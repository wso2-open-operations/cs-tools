# Copy to .env and fill in real values.

# Azure Flexible Server PostgreSQL connection.
PGHOST="<server>.postgres.database.azure.com"
PGDATABASE="alertintegration"
PGUSER="<db-user>"
PGPASSWORD="<db-password>"
# Optional: defaults to 5432.
PGPORT=5432
# Optional: defaults to "require" (Azure Flexible Server's minimum).
PGSSLMODE=require

# Optional JSON of fallback values applied to any alert field left empty, e.g.
# '{"severity":"warning","category":"service_interruption"}'. Empty/unset disables defaulting.
CORE_ALERT_DEFAULTS=

# Optional: csm-integration-service (M2M, OAuth2 client credentials). CSM delivery is enabled only when
# all five CSM_* values below (except SCOPES) and INCIDENT_DEFAULT_SERVICE_ID are set; otherwise incidents stay local and go to Chat.
CSM_INTEGRATION_BASE_URL="https://<csm-integration-service-host>"
CSM_INTEGRATION_TOKEN_URL="<oauth2-token-endpoint>"
CSM_INTEGRATION_CLIENT_ID=
CSM_INTEGRATION_CLIENT_SECRET=
# Optional: comma-separated OAuth2 scopes.
CSM_INTEGRATION_SCOPES=

# CreateIncidentRequest.callerId -- the CSM caller uuid every incident this service creates is
# attributed to.
CSM_CALLER_ID=

# CreateIncidentRequest.serviceId of the Default service; incidents for alerts with no or an unknown
# service use it, and entity-service assigns its support group (the default team). Must be the same
# value as entity-service's INCIDENT_DEFAULT_SERVICE_ID. Replaces CSM_UNKNOWN_SERVICE_ID, which is no
# longer read. alert-core never sends an assignment group: entity-service sets it from the service's
# support group, falling back to the Default service's.
INCIDENT_DEFAULT_SERVICE_ID=

# Comma-separated Google Chat incoming-webhook URLs, used only while CSM hasn't confirmed an
# incident. Empty means an unconfirmed incident has nowhere to be seen until CSM recovers.
FALLBACK_CHAT_WEBHOOK_URLS=

# Shared secret for POST /alertz, sent by sre-alert-ingestion-service as "Authorization: Bearer <token>".
# Generate it once with `openssl rand -hex 32` and set the same value as ALERT_CORE_WAKE_TOKEN on both services.
# At least 32 characters, or this service won't start. Unset rejects every wake; the poll.interval backstop still picks alerts up.
ALERT_CORE_WAKE_TOKEN=

# alert-core-service's HTTP port (/healthz, /livez, /alertz). Optional: defaults to 8080.
PORT=8080
