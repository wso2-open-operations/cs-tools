# Local-dev image for this service. Choreo deploys it from source via its
# own buildpack in every other environment -- this Dockerfile exists only
# so the service can run in the docker-compose stack described in
# apps/csm-portal/README.md.

FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o /out/csm-notification-service ./cmd/server

FROM alpine:3.20

# ca-certificates: this service (or one it talks to over TLS, e.g. a Kafka
# SASL_SSL broker or an HTTPS upstream) needs a real trust store, not just
# Go's built-in one, to verify the local dev CA generated by
# scripts/csm-compose/gen-dev-certs.sh.
RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /out/csm-notification-service ./csm-notification-service

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid 10104 \
    "csmdev"

USER 10104

ENTRYPOINT ["./csm-notification-service"]
