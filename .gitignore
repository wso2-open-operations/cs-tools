# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Configs and Environment files
.DS_Store
target
Config.toml
.env
# Every environment-file variant (.env.local, .env.staging, staging.env, ...)
# carries credentials; only the committed templates and the customer-portal
# webapp's credential-free .env.e2e are allowed back in.
.env.*
*.env
!.env.example
!*.env.example
!.env.e2e

# Key material and certificates, wherever they land (the local stack's dev
# CA lives in a Docker volume, but nothing generated by hand belongs here).
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Local session handoff documents — never committed/pushed
handoffs/

# Local working docs (PR reply/decision drafts, etc.) — never committed/pushed
local-docs/

# Local Claude Code config and installed skills — kept out of version
# control. Note other CLAUDE.md files in this repo (csm-portal,
# entity-service, integrations/*) are deliberately tracked, so those are
# ignored by exact path instead, unrelated to the .claude/ directory below.
.claude/
.agents/
skills-lock.json
apps/customer-portal/CLAUDE.md

# PLG runtime config — a file mount in a real deployment, never committed.
apps/csm-portal/backend/plg-source-map.json

# PLG's own documentation, kept locally rather than pushed.
apps/csm-portal/plg-docs/
docs/*

# The CS ABT roster sheet holds real staff names and leave. Neither the sheet
# nor anything generated from it -- exports, copies, import SQL -- belongs in
# this repository; scripts/csm-compose/import-abt-roster.py (no data) does.
*ABT Roster*
*abt-roster*.csv
*abt-roster*.sql
*abt-roster*.xlsx
# The importer's own output, whose documented name says nothing about the
# roster -- `import-abt-roster.py <sheet.xlsx> <tab> out.sql` -- so the
# patterns above miss it. It is full of real names and leave.
out.sql
scripts/csm-compose/out.sql
# Per-run copies of escalation.yaml written by trigger-escalation.sh -c / -m.
# They can carry your own phone number, so they are never committed.
scripts/csm-compose/.run/
# The SRE team's rotation workbook, and SQL generated from it.
*ABT-Rotation*
*sre-rotation*.sql
*sre-rotation*.csv

# Python bytecode from the roster importers. Build output, and the cached
# names give away the module names either way -- there is already a stale
# cpython-313 set sitting beside a 314 one.
__pycache__/
*.py[cod]
