# NOTE: every *_BASE_URL / *_URL / *_ENDPOINT below must be an absolute URL with
# a scheme and host (http/https; ws/wss for AI_CHAT_AGENT_WS_BASE_URL). The server
# strips surrounding quotes and whitespace, then validates at startup and exits
# with the offending variable named rather than failing per-request later.

# Shared OAuth2 client credentials — entity-service, the updates service, and
# SCIM all authenticate as this same app; only each service's base URL and
# scopes differ. Optional — only needed if a service sits behind a gateway
# that requires OAuth2 client-credentials auth. Leave unset for a local
# direct-to-service run.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# Entity service (cs-tools/entity-service)
ENTITY_SERVICE_BASE_URL=http://localhost:8081
ENTITY_SERVICE_SCOPES=

# WSO2 Updates service (product update levels / update descriptions)
UPDATES_BASE_URL=
UPDATES_SCOPES=

# SCIM operations service (phone number read/update for GET/PATCH /users/me)
SCIM_BASE_URL=
SCIM_SCOPES=

# AI chat agent — a separate Python service (not entity-service) powering
# case classification, chat, and KB recommendations. Authenticates as the
# same shared OAuth2 app as the services above; only the base URLs differ.
AI_CHAT_AGENT_BASE_URL=
AI_CHAT_AGENT_SCOPES=
AI_CHAT_AGENT_WS_BASE_URL=
AI_CHAT_AGENT_WS_SCOPES=

# Product-consumption services — not entity-service. These are two
# independently-configurable base URLs (subscription/license vs usage
# tracking), so set both here too. PRODUCT_CONSUMPTION_TRACKING_BASE_URL
# falls back to PRODUCT_CONSUMPTION_SUBSCRIPTION_URL when left unset — only
# needed if the two services are hosted separately.
PRODUCT_CONSUMPTION_SUBSCRIPTION_URL=
PRODUCT_CONSUMPTION_TRACKING_BASE_URL=
PRODUCT_CONSUMPTION_SCOPES=

# Registry service (robot-account / registry-token issuance, integration
# users) — a separate service, not entity-service. Every request carries an
# OAuth2 bearer token, so BASE_URL must be https:// — plain http is rejected
# unconditionally, including for localhost.
REGISTRY_BASE_URL=
REGISTRY_SCOPES=

# Project-contact onboarding service (project contact/membership
# add/remove/list/update-role) — a separate service, not entity-service, not
# SCIM. Same https-only rule as REGISTRY_BASE_URL above.
USER_MANAGEMENT_BASE_URL=
USER_MANAGEMENT_SCOPES=

# Auth
# AUTH_TOKEN_VALIDATOR_ENABLED=false (below) skips JWT signature verification —
# local development only. Production MUST set it to true with a real
# AUTH_JWKS_ENDPOINT/AUTH_ISSUER/AUTH_AUDIENCE.
AUTH_AUDIENCE=
AUTH_ISSUER=
AUTH_JWKS_ENDPOINT=
AUTH_TOKEN_VALIDATOR_ENABLED=false
# The role string (from entity-service's GET /users/me roles) that grants
# admin privileges for registry-token and project-contact management.
AUTH_ADMIN_ROLE=

# Every project-scoped search/detail endpoint (SearchProjects, SearchCases,
# GetCase, SearchCaseActivities, SearchCaseEscalations, SearchCallRequests,
# SearchRegistryTokens, SearchChangeRequests, SearchTimeCards,
# SearchProjectCaseTimeCards, SearchConversations, SearchDeployments, and
# InstanceHandler's project-scoped fan-out) always restricts results to
# projects/cases the caller has case access to, per entity-service's own
# project-contacts search (GrantsCaseAccess — the same endpoint CSM's
# backend already calls in production), checked one project at a time — see
# handler.CallerScopeResolver / requireProjectMember. No env var controls
# this; it's always on. Does NOT yet cover InstanceHandler's
# deployment-/deployed-product-scoped variants, or any globally-unscoped
# endpoint with no project id in its path (accounts/search,
# attachments/search, etc.) — see CLAUDE.md for the full breakdown.
# ServiceNow data source only.

# Server
PORT=8080
# The WebSocket endpoint (GET /ws) listens on its own port, separate from the
# REST API above — a browser cannot send the x-jwt-assertion header on a
# WebSocket handshake, so that listener runs without the Auth middleware and
# authenticates the token itself. Must match the customer-portal-websocket
# endpoint's port in .choreo/component.yaml. Optional — defaults to 8081.
WS_PORT=8081
