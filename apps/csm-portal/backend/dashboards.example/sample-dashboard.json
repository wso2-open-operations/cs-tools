{
  "id": "sample-dashboard",
  "displayName": "Sample Dashboard",
  "type": "cs",
  "isDefault": true,
  "targetTeam": "sample-team",
  "isTeamBased": false,
  "widgets": [
    {
      "id": "case-summary-open",
      "displayName": "Open",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "open"
            ]
          }
        ]
      }
    },
    {
      "id": "case-summary-work-in-progress",
      "displayName": "Work In Progress",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "work_in_progress"
            ]
          }
        ]
      }
    },
    {
      "id": "case-summary-awaiting-info",
      "displayName": "Awaiting Info",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "awaiting_info"
            ]
          }
        ]
      }
    },
    {
      "id": "case-summary-solution-proposed",
      "displayName": "Solution Proposed",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "solution_proposed"
            ]
          }
        ]
      }
    },
    {
      "id": "case-summary-waiting-on-wso2",
      "displayName": "Waiting on WSO2",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "waiting_on_wso2"
            ]
          }
        ]
      }
    },
    {
      "id": "case-summary-reopened",
      "displayName": "Reopened",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 4,
      "section": "Case Summary",
      "query": {
        "filters": [
          {
            "field": "state",
            "op": "in",
            "values": [
              "reopened"
            ]
          }
        ]
      }
    },
    {
      "id": "my-open-cases",
      "displayName": "My Open Cases",
      "resourceType": "case",
      "shape": "count",
      "gridWidth": 3,
      "query": {
        "filters": [
          {
            "field": "assignedUserId",
            "op": "in",
            "values": [
              "__current_user__"
            ]
          },
          {
            "field": "state",
            "op": "in",
            "values": [
              "open",
              "work_in_progress"
            ]
          }
        ]
      }
    },
    {
      "id": "recent-cases",
      "displayName": "Recent Cases",
      "resourceType": "case",
      "shape": "list",
      "gridWidth": 6,
      "listLimit": 5,
      "query": {
        "filters": [
          {
            "field": "tag",
            "op": "in",
            "values": [
              "example-tag"
            ]
          },
          {
            "field": "tag",
            "op": "notIn",
            "values": [
              "excluded-example-tag"
            ]
          }
        ]
      }
    },
    {
      "id": "pending-time-cards",
      "displayName": "Pending Time Cards",
      "resourceType": "time_card",
      "shape": "count",
      "gridWidth": 3,
      "query": {
        "states": [
          "pending"
        ]
      }
    }
  ]
}
