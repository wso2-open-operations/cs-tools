VITE_BACKEND_URL=https://example.com/api

# Base URL for the case-activity SSE stream — csm-portal-backend's dedicated
# :9092 listener, its own Choreo REST endpoint. Optional: leave unset in a
# build where Event Hub isn't configured on the backend, or to keep the
# Activities tab on manual refresh.
# VITE_STREAM_URL=https://example.com/stream
