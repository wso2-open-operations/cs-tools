window.config = {
  // OIDC IdP base URL for the configured identity provider.
  CSM_PORTAL_AUTH_BASE_URL: "<your-idp-base-url>",
  CSM_PORTAL_AUTH_CLIENT_ID: "<your-client-id>",
  CSM_PORTAL_AUTH_SIGN_IN_REDIRECT_URL: "http://localhost:3001",
  CSM_PORTAL_AUTH_SIGN_OUT_REDIRECT_URL: "http://localhost:3001",

  // csm-portal-backend (BFF) base URL. The FE never calls entity-service
  // directly; all entity queries go through the BFF, which proxies to
  // entity-service server-side.
  //
  // Azure stg example:
  // CSM_PORTAL_BACKEND_BASE_URL: "https://<choreo-org-id>-az-stg.prod.wdt.choreoapis.dev/<key>/csm-portal-backend/v1.0",
  CSM_PORTAL_BACKEND_BASE_URL: "<your-backend-base-url>",

  // Base URL for the case-activity SSE stream — csm-portal-backend's
  // dedicated :9092 listener, exposed as its own Choreo REST endpoint (see
  // that backend's .choreo/component.yaml). Optional: leave unset in an
  // environment where Event Hub isn't configured on the backend, or to keep
  // the Activities tab on manual-refresh/staleTime polling.
  // CSM_PORTAL_STREAM_BASE_URL: "<your-stream-base-url>",
  // Master on/off switch for the stream, independent of the URL above —
  // case detail pages only open a live connection when this is explicitly
  // true AND CSM_PORTAL_STREAM_BASE_URL is set. Defaults to false so an
  // environment doesn't get the feature live just because the URL happens
  // to be configured; flip to true once you've verified it end-to-end.
  CSM_PORTAL_STREAM_ENABLED: false,

  // Default Oxygen UI theme. One of: "acrylicOrange", "acrylicPurple",
  // "choreo", "classic", "highContrast". Users can override this at runtime via
  // the header theme dropdown (the choice is persisted per browser).
  // Default Oxygen UI theme. Derived at build time from whatever
  // @wso2/oxygen-ui exports as a theme (see src/config/themeConfig.ts) --
  // this list is illustrative, not exhaustive, and can grow on an
  // oxygen-ui bump without a code change here. As of oxygen-ui 0.13.1, the
  // theme picker offers: "acrylicOrange", "acrylicPurple", "oxygen",
  // "paleBase", "paleGray", "paleIndigo", "wso2" ("classic" and
  // "highContrast" still resolve as a config/persisted value for back-compat
  // but are no longer offered in the picker). Users can override this at
  // runtime via the header theme dropdown (the choice is persisted per
  // browser).
  CSM_PORTAL_THEME: "acrylicOrange",
  CSM_PORTAL_LOG_LEVEL: "ERROR",

  // TEMPORARY / LOCAL DEV ONLY. Bypasses the post-sign-in *authorization*
  // checks (portal-role gate, per-section capabilities, SPL audience gate)
  // for an account the real backend hasn't provisioned a portal role for
  // yet — does NOT touch Asgardeo sign-in itself. See
  // src/config/authConfig.ts's devBypassAccessCheck. Leave unset/false here
  // and in any committed config — only set true in your own local,
  // gitignored config.js.
  // CSM_PORTAL_DEV_BYPASS_ACCESS_CHECK: true,

  // TEMPORARY / LOCAL DEV ONLY. Forces which of the two independent views
  // ("cs-abt" or "sales-sa") the app renders — see
  // src/context/current-user/usePortalView.ts. Leave unset to let it decide
  // for itself (defaults to "cs-abt" under the bypass above, or the real
  // Asgardeo-groups check once that flag is off). Leave unset/false here and
  // in any committed config.
  // CSM_PORTAL_DEV_VIEW_OVERRIDE: "sales-sa",

  // Per-page visibility. Keys are nav-node ids from src/config/csmNavItems.ts:
  // a section id ("operations") or one of its tabs ("operations.incidents").
  // Values:
  //   "enabled" - normal. Also what any page NOT listed here gets, so only
  //               list a page when you want to restrict it.
  //   "wip"     - visible but greyed out with a "work in progress" tooltip,
  //               dropped from the quick-nav palette, routes render the shared
  //               "coming soon" page.
  //   "hidden"  - no nav entry at all, routes redirect to the dashboard.
  //
  // A section's setting cascades to its tabs, and a tab can override it: the
  // block below marks Operations as WIP while keeping the finished Incidents
  // tab usable (which also keeps Operations itself clickable). A "hidden"
  // section hides its tabs unconditionally.
  //
  // Available ids: dashboard, support, operations{.service-requests,
  // .change-requests, .incidents, .problems}, engagements, security-center
  // {.reports, .vulnerabilities}, updates, time-cards, announcements,
  // customers{.accounts, .projects}, admin{.user-management{.users, .roles,
  // .groups, .teams, .permissions}, .dashboards}. Unknown ids are ignored
  // with a console warning.
  CSM_PORTAL_FEATURE_OVERRIDES: {
    "operations": "wip",
    "operations.incidents": "enabled",
    "customers": "wip",
    "admin": "wip",
    "admin.user-management.users": "enabled",
  },

  // Mock data: when true, data hooks short-circuit to seeded fixtures instead
  // of calling the backend. Leave false (or unset) to use the live backend.
  CSM_PORTAL_USE_MOCKS: false,
  // Show the in-header mock-data toggle so the value above can be flipped at
  // runtime (persisted per-browser). Keep false in production — engineers must
  // not be able to switch to fake data against live cases.
  CSM_PORTAL_ALLOW_MOCK_TOGGLE: false,

  CSM_PORTAL_MAINTENANCE_BANNER_VISIBLE: false,
  // Optional maintenance banner overrides:
  // CSM_PORTAL_MAINTENANCE_BANNER_SEVERITY: "info",
  // CSM_PORTAL_MAINTENANCE_BANNER_TITLE: "Scheduled maintenance",
  // CSM_PORTAL_MAINTENANCE_BANNER_MESSAGE: "Some services may be unavailable.",
  // CSM_PORTAL_MAINTENANCE_BANNER_ACTION_LABEL: "Learn more",
  // CSM_PORTAL_MAINTENANCE_BANNER_ACTION_URL: "https://example.com",

  // ── Top banners ─────────────────────────────────────────────────────────────
  //
  // CSM_PORTAL_TOP_BANNERS  (optional, default: [])
  //   An ordered array of banner objects rendered at the very top of every
  //   page, stacked above the main header, top-to-bottom in array order.
  //
  //   To add a banner  -> push a new object into the array.
  //   To remove one    -> delete its object, or set enabled: false.
  //   No code changes are required, only this file needs updating.
  //
  //   Each object supports four fields, plus two optional ones (startsAt, expiresAt):
  //
  //   enabled {boolean}
  //     true  - banner is rendered on every page.
  //     false - banner is skipped entirely. Safe to leave in the array.
  //
  //   closeable {boolean}
  //     true  - a close (x) button appears in the top-right corner. When
  //             clicked the banner is hidden and the dismissed state is saved
  //             in localStorage under `storageKey`. The banner will not
  //             reappear until storageKey is changed.
  //     false - no close button; banner is always visible.
  //
  //   storageKey {string}
  //     Unique localStorage key used to track whether this banner was
  //     dismissed. Required when closeable is true; if missing a warning is
  //     logged and a shared fallback key is used (risks collisions).
  //     Change this value whenever banner content changes so returning users
  //     see the updated version again.
  //     Recommended format: "<purpose>_banner_<year>_v<version>"
  //
  //   html {string}
  //     Self-contained HTML for the banner body. All styling must be inline;
  //     no external CSS classes are available. The HTML is sanitized: scripts
  //     and event-handler attributes are removed. Inline styles, <a>
  //     (including target="_blank"), <img> and basic text tags are kept.
  //     - Host images on a stable CDN; temporary signed URLs expire.
  //     - Do NOT add a close button inside html: the app injects one when
  //       closeable is true.
  //
  //   startsAt {string}  (optional)
  //     ISO 8601 timestamp WITH a UTC offset, e.g. "2026-10-08T09:00:00+05:30"
  //     or "2026-10-08T03:30:00Z". The banner is not rendered before that
  //     instant and appears from then on (still subject to enabled / closeable /
  //     dismissal). A page that is already open shows it live when the time
  //     arrives, no reload needed. Omit it to show the banner immediately.
  //     An unparseable value is ignored (no start gate) and a warning is
  //     logged. If startsAt is at or after expiresAt the banner never shows
  //     (a warning is logged).
  //
  //   expiresAt {string}  (optional)
  //     ISO 8601 timestamp WITH a UTC offset, e.g. "2026-10-10T18:00:00+05:30"
  //     or "2026-10-10T12:30:00Z". From that instant on the banner is not
  //     rendered, regardless of enabled / closeable / dismissal. A page that
  //     is already open hides it live when the time passes, no reload needed.
  //     Omit it for a banner that never expires. An unparseable value is
  //     ignored (the banner stays visible) and a warning is logged.
  //
  CSM_PORTAL_TOP_BANNERS: [
    // Banner 1: non-dismissable event/promotion banner
    {
      enabled: false,
      closeable: false,
      storageKey: "event_banner_2026_v1",
      startsAt: "2026-10-08T09:00:00+05:30", // optional: show only from this time
      expiresAt: "2026-10-10T18:00:00+05:30", // optional: auto-hide after this time
      html: '<div style="background-color:#000;height:3rem"><a href="https://example.com" target="_blank"><img style="object-fit:cover;height:100%;width:100%" src="https://cdn.example.com/event-banner.png" role="presentation"></a></div>',
    },
    // Banner 2: dismissable announcement banner (close button injected automatically)
    {
      enabled: false,
      closeable: true,
      storageKey: "announcement_banner_2026_v1",
      html: '<div style="background-color:#000;height:3rem;overflow:hidden"><img style="object-fit:cover;height:100%;width:100%;display:block" src="https://cdn.example.com/announcement.png" role="presentation"></div>',
    },
  ],

  // Legacy single banner (still supported, rendered before CSM_PORTAL_TOP_BANNERS):
  //   CSM_PORTAL_TOP_BANNER_HTML as a raw HTML string is shown as one
  //   non-closeable banner only when CSM_PORTAL_TOP_BANNER_ENABLED is true.
  //   CSM_PORTAL_TOP_BANNER_HTML may also be a banner object
  //   ({ enabled, closeable, storageKey, html, startsAt?, expiresAt? }); it then
  //   follows that object's own fields (including startsAt and expiresAt) and CSM_PORTAL_TOP_BANNER_ENABLED is ignored.
  //   New deployments should use CSM_PORTAL_TOP_BANNERS instead.
  CSM_PORTAL_TOP_BANNER_ENABLED: false,
  // CSM_PORTAL_TOP_BANNER_HTML: '<div style="background-color:#000;height:3rem">...</div>',

  // Dismissible banner nudging engineers on a detected mobile phone browser
  // toward the WSO2 Super App micro-app. Unlike the customer portal, this
  // never blocks access -- engineers can dismiss it and keep using the web
  // portal on a phone. Leave the store URLs unset to suppress the banner
  // even when enabled (no download destination to offer).
  CSM_PORTAL_MOBILE_APP_PROMPT_ENABLED: false,
  // CSM_PORTAL_MOBILE_APP_IOS_STORE_URL: "https://apps.apple.com/app/id0000000000",
  // CSM_PORTAL_MOBILE_APP_ANDROID_STORE_URL: "https://play.google.com/store/apps/details?id=com.example.app",
  // Also show the banner on tablets, not just phones (default false).
  // CSM_PORTAL_MOBILE_APP_INCLUDE_TABLETS: false,

  // SPL (Support Portal Lite) section — ported from the former standalone
  // apps/support-portal-lite/webapp, now served by this app against the
  // same CSM_PORTAL_BACKEND_BASE_URL above (its /spl/* routes). Access is
  // driven entirely by the signed-in user's GET /users/me roles (the
  // sales_solutions role for the section itself, plus escalator/
  // attachment_downloader/usage_metrics_viewer for its fine-grained
  // actions — see AUTH_SALES_SOLUTIONS_ROLES etc. in the backend's own
  // .env.example) — no separate frontend config needed.

  // Customer-onboarding status column on a project's Contacts tab: per
  // contact, how far their Customer Portal invitation got (IDENTITY /
  // DATABASE / EMAIL / REGISTRATION), with the failing step and its last
  // error on hover. Off by default; only `true` turns it on, and the backend
  // must have the env var of the same name set to "true" too, or the column
  // reads "Unavailable". Off means no column and no request.
  CSM_MIGRATION_ONBOARDING_STATUS_ENABLED: true,

  // Project key an announcement's "Send test" dry run creates its one real
  // test case in (mirrors the ServiceNow flow's own hardcoded
  // Project Key = DCPSUB dry-run scoping). Defaults to "DCPSUB" itself when
  // unset -- override only if this environment needs a different sandbox project.
  // CSM_PORTAL_ANNOUNCEMENT_TEST_PROJECT_KEY: "DCPSUB",
};
