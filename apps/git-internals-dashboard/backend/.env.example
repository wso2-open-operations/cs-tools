# Postgres DSN. Local default matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://gid:gid@localhost:5433/gid?sslmode=disable

# HTTP listen port. Default 8080.
PORT=8080

# Fine-grained GitHub PAT (Issues:Read + Projects:Read). Used by: on-demand
# titles (POST /issues/titles), incremental sync (POST /sync/runs), and
# real-GitHub seed (cmd/seed). Unset => titles resolve to null, POST
# /sync/runs returns the sync_token_missing error, seed falls back to
# synthetic fixtures.
GITHUB_TOKEN=

# Comma-separated allow-list of browser Origins permitted to connect
# cross-origin. Fail-closed: unset denies every cross-origin browser
# request (see internal/middleware/cors.go). In Choreo the gateway supplies
# CORS instead, making this a no-op there. Local dev:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 0 disables the recompute scheduler (tests/CI). Default on.
RECOMPUTE_ENABLED=1

# Override the sla-config.yaml path. Default config/sla-config.yaml
# (relative to the process's working directory).
SLA_CONFIG_PATH=

# slog level: debug | info | warn | error. Default info.
LOG_LEVEL=info

# Set to "1" to fail `make seed` when it encounters a board status not
# present in the config taxonomy (default: log a warning and continue).
SEED_STRICT_TAXONOMY=
