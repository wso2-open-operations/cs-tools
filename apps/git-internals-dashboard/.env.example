# Copy to .env for local development: cp .env.example .env

# --- Database ---
# Postgres started via `docker compose up -d` (maps to localhost:5433).
DATABASE_URL="postgresql://sla:sla@localhost:5433/sla"
# DATABASE_URL=

# --- Auth ---
# stub    = every request is treated as an authenticated stub user (default, local dev/CI).
# asgardeo = Bearer JWT verification against an Asgardeo tenant + group check.
AUTH_MODE=stub
NEXT_PUBLIC_AUTH_MODE=stub

# Required only when AUTH_MODE=asgardeo.
# ASGARDEO_BASE_URL=
# ASGARDEO_CLIENT_ID=
# ASGARDEO_AUDIENCE=
# AUTH_ALLOWED_GROUP=
# AUTH_GROUPS_CLAIM=groups
# AUTH_DEBUG_CLAIMS=0

# NEXT_PUBLIC_* vars are inlined at build time (see Dockerfile ARGs), not read at container startup.
# NEXT_PUBLIC_ASGARDEO_BASE_URL=
# NEXT_PUBLIC_ASGARDEO_CLIENT_ID=
# NEXT_PUBLIC_ASGARDEO_SCOPES="openid groups"

# --- GitHub ingest/seed ---
# Fine-grained PAT with Issues:Read + Projects:Read. 
# Leave unset to seed with synthetic fixtures instead of real GitHub data.
# SEED_GITHUB_TOKEN=
# Fail the seed on unknown taxonomy statuses instead of warning.
# SEED_STRICT_TAXONOMY=0
# Used to fetch issue titles on demand; leave unset to keep titles redacted.
# GITHUB_TOKEN=

# --- Misc ---
# Set to 0 to disable the background recompute job started from instrumentation.ts.
# RECOMPUTE_ENABLED=1
# Override the SLA taxonomy/config file path (defaults to config/sla-config.yaml).
# SLA_CONFIG_PATH=