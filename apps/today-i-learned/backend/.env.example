# Settings for til-backend, read from the environment. Copy to .env for a
# local run (see README.md). Lists are comma-separated.

# --- Server -----------------------------------------------------------------
PORT=9090
# Go durations (e.g. 15s, 1m).
REST_READ_TIMEOUT=15s
REST_WRITE_TIMEOUT=45s
# Browser origins allowed to call the API. Empty allows none.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (required) ----------------------------------------------------
# Run sql/create_til_tables.sql against this database before starting the service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=til
# Optional, for a server that requires secure transport. true encrypts the
# connection and checks the server's certificate, which must come from a CA
# the system trusts and name DB_HOST. skip-verify encrypts it without checking
# the certificate; use it only when the certificate can't be verified.
DB_TLS=false

# --- Auth (required) --------------------------------------------------------
# Where the keys that sign x-jwt-assertion are published, and its issuer.
AUTH_JWKS_ENDPOINT=https://api.asgardeo.io/t/<org>/oauth2/jwks
AUTH_ISSUER=https://api.asgardeo.io/t/<org>/oauth2/token
# Optional. Client ids a token must be issued to (aud, client_id or azp).
# Empty accepts any client from the issuer.
AUTH_AUDIENCE=
# Groups whose members may edit and delete anyone's entries.
AUTH_MODERATOR_GROUPS=

# --- One WSO2 webapp ----------------------------------------------------------
# The webapp's Asgardeo client id. Only a token issued to it may share or
# edit entries; empty means no one can.
ONE_WSO2_WEBAPP_CLIENT_ID=
# The webapp's address, for the "Read more" link in Google Chat and the TIL
# logo it serves at /til-logo.png. Chat only shows the logo over https.
# Optional.
ONE_WSO2_BASE_URL=http://localhost:3000

# --- Entries -------------------------------------------------------------------
# The most characters of text a learning may have, markup not counted: 1–5000.
# Optional; 500 when unset. The webapp's form reads it from GET /settings and
# stops there; the backend accepts 20 more, as a margin for counting differences.
ENTRY_TEXT_MAX_LENGTH=

# --- Google Chat announcements (optional) ----------------------------------------
# Novera's POST /internal/notifications endpoint, and a client-credentials
# application subscribed to it at the gateway. Set all four, or none to turn
# announcements off.
NOVERA_NOTIFY_URL=
NOVERA_TOKEN_URL=
NOVERA_CLIENT_ID=
NOVERA_CLIENT_SECRET=
