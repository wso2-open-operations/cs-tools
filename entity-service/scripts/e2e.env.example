# Configuration for github-integration-e2e.sh. Copy somewhere OUTSIDE the repo,
# fill in, and point the script at it:  ENV_FILE=~/e2e.env ./github-integration-e2e.sh
#
# Never commit a filled-in copy: GITHUB_TOKEN and GITHUB_WEBHOOK_SECRET are
# credentials, and DB_PASSWORD is a database password.

# --- the database the triggers live in -------------------------------------
DATA_SOURCE=postgres
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# --- GitHub ----------------------------------------------------------------
GITHUB_INTEGRATION_ENABLED=true
# Fine-grained PAT. Needs Issues: read & write on the target repository only.
GITHUB_TOKEN=
# Any random string. The SAME value goes in the repository's webhook settings.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The account our own writes come from. Events sent by this login are dropped,
# which is what stops a comment we post being synced back as a new one.
GITHUB_INTEGRATION_LOGIN=csm-sync-bot
GITHUB_OUTBOUND_INTERVAL=2s

# The repository the test drives. Use a scratch repo, never a customer's.
GITHUB_OWNER=
GITHUB_REPO=

# --- what the comments link to ---------------------------------------------
# Must be the POSTGRES-BACKED portal. Pointing this at a ServiceNow-backed
# portal produces comments whose links cannot resolve the record they describe.
CSM_PORTAL_BASE_URL=

# --- the fixtures the test drives ------------------------------------------
# An account with at least one case that has at least one change request under
# it. Prefer a test account: the script closes the case and reassigns it, then
# restores both.
TEST_ACCOUNT_NAME=
TEST_CASE_ID=

SERVER_PORT=18590
HEALTH_PORT=18591
