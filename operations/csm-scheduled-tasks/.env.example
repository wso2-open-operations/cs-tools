# Shared OAuth2 client credentials — used by the entity-service client and
# the email client below, and by any future service client this component
# grows. Mirrors integrations/csm-notification-service's own
# OAUTH2_CLIENT_ID/OAUTH2_CLIENT_SECRET/OAUTH2_TOKEN_URL convention: the real
# deployments these point at authenticate every caller through the same
# shared gateway app, scoped per-client via each client's own *_SCOPES var
# below, not a separate app per consumer. Required — entity-service (and
# therefore this whole component) cannot function without these.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# entity-service is this component's only durable state — every claim,
# retry, success, and failure is persisted against its scheduled_task_run
# table (see entity-service's own CLAUDE.md, "Scheduled task runs").
# Authenticates with the shared OAUTH2_* credentials above, not its own —
# only BaseURL/Scopes are specific to this client.
CUSTOMER_ENTITY_SERVICE_BASE_URL=
# Comma-separated, optional.
CUSTOMER_ENTITY_SERVICE_SCOPES=

# Email notification channel — optional, but required (checked at startup)
# if ALERT_RECIPIENTS below is non-empty, or any registered task has its own
# "to" list in SUB_CRON_RECIPIENTS below. Authenticates with the same shared
# OAUTH2_* credentials above, not its own — only BaseURL/Scopes/FromAddress
# are specific to this client.
EMAIL_BASE_URL=
EMAIL_SCOPES=
EMAIL_FROM_ADDRESS=

# Global kill switch for every email this component sends — both failure
# alerts (regardless of ALERT_RECIPIENTS or any task's SUB_CRON_RECIPIENTS
# "to") and any report-style task's own success email. A failed task still
# gets recorded/logged and retries normally either way; a report-style task
# still succeeds either way too, but may skip doing any work at all for that
# tick rather than just skipping the send — see this component's own
# CLAUDE.md for which tasks work that way. Defaults to true (send) when
# unset; set to false for a maintenance window or a known-noisy period
# without touching any recipients config.
ALERTS_ENABLED=

# Comma-separated standing ops/on-call audience, emailed on every failed
# sub-cron attempt, for every task — always included in addition to
# whatever that specific task's own recipients (SUB_CRON_RECIPIENTS below)
# add. Most tasks will have no entry in SUB_CRON_RECIPIENTS and rely on
# this list alone. Empty/unset here, combined with no per-task "to" either,
# means that task's failures send no email at all.
ALERT_RECIPIENTS=

# Optional: per-task To/Cc, by name, without needing a dedicated env var per
# task — a JSON object of {"<task.Name>": {"to": ["..."], "cc": ["..."]}}.
# For most tasks this is additional failure-alert audience: a task not
# mentioned here just gets no per-task recipients, and its failures still
# reach ALERT_RECIPIENTS above. A report-style task instead uses its own
# "to"/"cc" here as its actual report recipients, unrelated to
# ALERT_RECIPIENTS — see this component's own CLAUDE.md for which tasks work
# that way.
SUB_CRON_RECIPIENTS=

# This component's own expected invocation cadence — must match the cron
# trigger configured on the Choreo Scheduled Task component itself. Used as
# the default retry backoff for a task whose own RetryBackoff is zero, and
# to size the orphaned-claim safety margin passed to entity-service.
DRIVER_INTERVAL=

# Optional: override any registered task's schedule by name, without
# needing a dedicated env var per task — a JSON object of
# {"<task.Name>": "<cron expression>"}. A task not mentioned here just
# keeps its own hardcoded default schedule from cmd/server/main.go. This is
# the one config surface every sub-cron's cadence goes through as the
# registry grows — add a new task in code with a sensible default, then
# optionally tune its cadence here without a redeploy.
SUB_CRON_SCHEDULES=

# How many days of resolved (succeeded/superseded) scheduled_task_run
# history the "housekeeping_cleanup" sub-cron keeps in entity-service
# before deleting it — a plain integer, not a Go duration string. A row
# still failed/retrying is never deleted regardless of age. Defaults to 30
# when unset.
HOUSEKEEPING_RETENTION_DAYS=

# Cloud status webhooks — the port of ServiceNow's Cloud Status Event
# Notification Flow. entity-service decides which outage transitions owe a
# webhook; this component delivers them.
#
# *** OFF BY DEFAULT, AND TURNING IT ON IS A PAIRED CHANGE. *** While the
# ServiceNow flows `Cloud Status Event Notification Flow` and
# `... - Affected CI` are still active, enabling this posts every event
# twice. Deactivate them in the same change.
# CLOUD_STATUS_ENABLED=true

# Per-cloud base URLs for the status dashboard, as JSON. Keys are the cloud
# slugs: asgardeo, choreo, bijira, devant, moesif, choreo-eu, agent-manager.
#
# POINT EVERY CLOUD AT THE COMMON BACKEND. ServiceNow's
# cloud_status.asgardeo.webhook.url names a host that returns 403 on
# everything and has done since 2023; with retry disabled there, those
# webhooks have simply been lost. Do not carry that value across.
# CLOUD_STATUS_WEBHOOK_URLS={"asgardeo":"https://...","choreo":"https://..."}

# The X-Webhook-Signature header value, as JSON. A single {"default": "..."}
# entry covers every cloud, which is what ServiceNow does -- it signs all of
# them with one secret. The per-cloud keys exist so the arrangement can be
# split later without a code change.
#
# *** THE VALUE IS THE WHOLE HEADER, INCLUDING THE "Secret " PREFIX. *** The
# dashboard compares against `Secret <token>` and rejects a bare token with
# 401. Note this differs from the dashboard's own Key Vault entry, which
# holds the BARE token because its middleware adds the prefix itself. Same
# secret, two shapes.
# CLOUD_STATUS_WEBHOOK_SECRETS={"default":"Secret <token>"}

# Rota reminders -- plain emails about rotation shifts in the Team Schedule,
# each with a calendar invitation that has everybody on the window as a guest:
#   - weekday: one email per shift window, to the people on it -- the Morning
#     window (with its on-call person) and the Evening window -- at 15:00
#     Colombo time the working day before (Friday announces Monday);
#   - weekend: every evening at 20:00 from Sunday to Thursday, once the coming
#     weekend is fully marked, one summary email to everybody on it and one
#     invitation email per team per day (sent once); until then the rota
#     admins are asked to finish it. On Friday at 15:00, a reminder.
# People on leave are left out by entity-service.
#
# The tasks' SUB_CRON_RECIPIENTS entries get their failure alerts, as for
# every task here, but are NOT copied on the reminders unless
# ROTA_REMINDER_COPY_TASK_RECIPIENTS=true.
# ROTA_REMINDER_COPY_TASK_RECIPIENTS=false
#
# *** OFF BY DEFAULT. *** These email real staff from the real rota. In an
# environment that holds the real rota but must not mail people, turn them on
# only with ROTA_REMINDER_REDIRECT_TO set. Needs EMAIL_BASE_URL, and this
# client's id in entity-service's M2M_CLIENT_IDS (the Team Schedule is
# internal-only).
# ROTA_REMINDERS_ENABLED=true

# Non-production: send every reminder here instead of to the people on the
# shift, with the intended recipients named in the body. Comma-separated.
# ROTA_REMINDER_REDIRECT_TO=rota-test@example.com

# Optional link to the CSM portal's Team Schedule page, shown in every reminder.
# ROTA_REMINDER_SCHEDULE_URL=https://.../team-schedule

# Which rota and which shifts, as CODE=Name (the name the email shows). An
# on-call variant (<CODE>_OC) is announced in the same email as <CODE>.
# Defaults shown.
# ROTA_REMINDER_FAMILY=CRE
# ROTA_REMINDER_WEEKDAY_SHIFTS=CRE_MORNING=Morning,CRE_MORNING_OC=On-call,CRE_EVENING=Evening
# ROTA_REMINDER_WEEKEND_SHIFTS=CRE_WEEKEND=LK Weekend,CRE_WEEKEND_NIGHT=Americas Weekend,CRE_WEEKEND_NIGHT_OC=LK On-call
# A rotation's own hours on its own clock, used instead of the Team Schedule's
# (CODE=HH:MM-HH:MM Zone, comma-separated; empty = the Team Schedule's hours).
# ROTA_REMINDER_WINDOWS=CRE_WEEKEND_NIGHT=08:00-18:00 America/Los_Angeles,CRE_WEEKEND_NIGHT_OC=08:00-18:00 America/Los_Angeles

# The calendar "tomorrow" is counted in. Default Asia/Colombo.
# ROTA_REMINDER_TIME_ZONE=Asia/Colombo

# Calendar invitations need EMAIL_FROM_ADDRESS (the organizer). Default on.
# ROTA_REMINDER_INVITES_ENABLED=true

# How many people each weekend shift needs on each day before the weekend is
# announced (the on-call variant does not count). Default shown.
# ROTA_REMINDER_WEEKEND_REQUIRED=CRE_WEEKEND=3,CRE_WEEKEND_NIGHT=1

# Usage rollups (hourly -> daily -> monthly). Off by default: enable only once
# ServiceNow's aggregation jobs and csm-sync-service's mirroring of the same tables
# are off. This component's client id must be in entity-service's M2M_CLIENT_IDS.
# USAGE_ROLLUP_ENABLED=true
# USAGE_ROLLUP_DAILY_LOOKBACK_DAYS=2

# Monthly product regression reports -- one task per business unit
# (product_regression_report_apim / _iam / _integration), each mailing last
# month's regression-tagged cases for its own products, grouped by product,
# at 09:00 IST on the 1st (30 3 1 * *). Recipients are each task's own
# SUB_CRON_RECIPIENTS entry; a report with no "to" is skipped, and so is a
# month with no cases. The product lists are built in; replace one with a
# JSON object of report key to names (a key that is not a report, or an
# empty list, refuses to start).
# PRODUCT_REGRESSION_REPORT_PRODUCTS={"apim":["WSO2 API Manager","WSO2 Microgateway"]}

# Optional case page prefix: each case id links to <prefix>/<case number>.
# Unset renders the ids as plain text. Must be https.
# PRODUCT_REGRESSION_REPORT_LINK_BASE_URL=https://example.com/cases

# Case auto-closure -- OFF unless true. It comments on and closes customers'
# tickets. entity-service must have AUTOCLOSURE_SYSTEM_USER_EMAIL set and this
# component's client id in its M2M_CLIENT_IDS. See CLAUDE.md, "Case auto-closure".
# AUTOCLOSURE_ENABLED=false
# AUTOCLOSURE_INTERVAL_DAYS=7
# AUTOCLOSURE_DAILY_LIMIT=500
# Decide and log only: no comment, no step change, no closure. A TRYOUT_TASK of
# case_autoclosure is always a dry run, whatever this says.
# AUTOCLOSURE_DRY_RUN=false
# Run solution_proposed alone first, then add awaiting_info.
# AUTOCLOSURE_STATES=solution_proposed,awaiting_info
# AUTOCLOSURE_TEMPLATES={"awaiting_info.first_reminder":"..."}
