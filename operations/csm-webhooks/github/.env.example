# The public GitHub webhook endpoint. Verifies the HMAC and forwards to
# entity-service; holds no database credentials and decides nothing.

# The HMAC key GitHub signs deliveries with — the SAME value configured on the
# repository's webhook. THIS IS THE ONLY AUTHENTICATION on /webhooks/github:
# GitHub cannot present a bearer token. Empty makes the endpoint refuse
# everything rather than accept everything.
GITHUB_WEBHOOK_SECRET=

# entity-service, reached over the internal network. It is Organization-
# visible in Choreo, which is the whole reason this component exists.
ENTITY_BASE_URL=
ENTITY_TOKEN_URL=
ENTITY_CLIENT_ID=
ENTITY_CLIENT_SECRET=
ENTITY_SCOPES=

# The client id above must appear in entity-service's M2M_CLIENT_IDS,
# or every forward is refused with 401 and no delivery is ever applied.

PORT=8080
